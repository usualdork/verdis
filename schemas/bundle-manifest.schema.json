{
  "$defs": {
    "BundleFile": {
      "additionalProperties": false,
      "description": "One file in the bundle, with its hash (evidence-tampering defence).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "default": 0,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "BundleFile",
      "type": "object"
    },
    "EnvironmentInfo": {
      "additionalProperties": false,
      "description": "Environment recorded in the manifest (section 8.3).",
      "properties": {
        "image_digests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Image Digests",
          "type": "array"
        },
        "isolation": {
          "default": "",
          "title": "Isolation",
          "type": "string"
        },
        "kernel": {
          "default": "",
          "title": "Kernel",
          "type": "string"
        },
        "os": {
          "default": "",
          "title": "Os",
          "type": "string"
        },
        "sandbox_backend": {
          "default": "",
          "title": "Sandbox Backend",
          "type": "string"
        },
        "sandbox_profile": {
          "default": "default",
          "title": "Sandbox Profile",
          "type": "string"
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        }
      },
      "title": "EnvironmentInfo",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "description": "Which model produced which part, and at what version.",
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "description": "The modelled cost of the model calls.",
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "prompt_hash": {
          "default": "",
          "title": "Prompt Hash",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "redactions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redactions",
          "type": "array"
        },
        "response_hash": {
          "default": "",
          "title": "Response Hash",
          "type": "string"
        },
        "tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Used",
          "type": "integer"
        },
        "used_for": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Used For",
          "type": "array"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "ModelInfo",
      "type": "object"
    }
  },
  "$id": "https://usualdork.github.io/verdis/schemas/bundle-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The manifest at the root of an evidence bundle.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentInfo"
    },
    "extra": {
      "additionalProperties": true,
      "title": "Extra",
      "type": "object"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BundleFile"
      },
      "title": "Files",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "additionalProperties": true,
      "title": "Target",
      "type": "object"
    },
    "tool_commit": {
      "default": "",
      "title": "Tool Commit",
      "type": "string"
    },
    "tool_version": {
      "default": "",
      "title": "Tool Version",
      "type": "string"
    },
    "verdict": {
      "default": "",
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "report_id"
  ],
  "title": "BundleManifest",
  "type": "object"
}
